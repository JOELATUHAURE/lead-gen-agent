GOOGLE_PLACES_API_KEY=your_google_places_key_here

# Supabase (Settings > API in your project dashboard)
SUPABASE_URL=https://gsyavvmmvgncageifkby.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Default country for parsing phone numbers into E.164 (ISO 3166-1 alpha-2)
DEFAULT_COUNTRY=UG

# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here
WHATSAPP_ACCESS_TOKEN=your_access_token_here
WHATSAPP_TEMPLATE_NAME=your_approved_template_name
WHATSAPP_TEMPLATE_LANG=en_US
